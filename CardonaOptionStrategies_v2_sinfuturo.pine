//@version=5
strategy("Cardona v2 sin futuro", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, currency=currency.USD, max_labels_count=500, max_boxes_count=500)

// ==========================================
// 1. CONFIGURACIÓN DE MEDIAS MÓVILES (uCharts style)
// ==========================================
var string GP_MAS = "Medias Móviles (uCharts)"
show_mas = input.bool(true, "Mostrar Medias Móviles", group=GP_MAS)

type_pm10 = input.string("SMA", "Tipo PM 10", options=["SMA", "EMA"], group=GP_MAS)
len_pm10  = input.int(10, "Longitud PM 10", group=GP_MAS)
color_pm10  = color.rgb(255, 255, 255)

type_pm20 = input.string("SMA", "Tipo PM 20", options=["SMA", "EMA"], group=GP_MAS)
len_pm20  = input.int(20, "Longitud PM 20", group=GP_MAS)
color_pm20  = color.rgb(241, 240, 49)

type_pm40 = input.string("SMA", "Tipo PM 40", options=["SMA", "EMA"], group=GP_MAS)
len_pm40  = input.int(40, "Longitud PM 40", group=GP_MAS)
color_pm40  = color.rgb(243, 0, 4)

type_pm100 = input.string("SMA", "Tipo PM 100", options=["SMA", "EMA"], group=GP_MAS)
len_pm100  = input.int(100, "Longitud PM 100", group=GP_MAS)
color_pm100 = color.rgb(73, 217, 44)

type_pm200 = input.string("SMA", "Tipo PM 200", options=["SMA", "EMA"], group=GP_MAS)
len_pm200  = input.int(200, "Longitud PM 200", group=GP_MAS)
color_pm200 = color.rgb(163, 64, 251)

// Función para obtener promedio
get_ma(type_ma, src, len) =>
    type_ma == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

pm10  = get_ma(type_pm10, close, len_pm10)
pm20  = get_ma(type_pm20, close, len_pm20)
pm40  = get_ma(type_pm40, close, len_pm40)
pm100 = get_ma(type_pm100, close, len_pm100)
pm200 = get_ma(type_pm200, close, len_pm200)

plot(show_mas ? pm10 : na, color=color_pm10, title="PM 10", linewidth=1)
plot(show_mas ? pm20 : na, color=color_pm20, title="PM 20", linewidth=1)
plot(show_mas ? pm40 : na, color=color_pm40, title="PM 40", linewidth=1)
plot(show_mas ? pm100 : na, color=color_pm100, title="PM 100", linewidth=2)
plot(show_mas ? pm200 : na, color=color_pm200, title="PM 200", linewidth=2)

// ==========================================
// 2. CONTEXTO DIARIO (Daily Timeframe)
// ==========================================
d_open = request.security(syminfo.tickerid, "D", open[1], barmerge.gaps_off, barmerge.lookahead_on)
d_high = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
d_low = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_on)
d_close = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)
d_sma100 = request.security(syminfo.tickerid, "D", ta.sma(close, 100)[1], barmerge.gaps_off, barmerge.lookahead_on)
d_sma200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200)[1], barmerge.gaps_off, barmerge.lookahead_on)

d_trend_bullish = d_close > d_sma100 and d_sma100 > d_sma200
d_near_sma100 = math.abs(d_close - d_sma100) / d_sma100 < 0.015
d_near_sma200 = math.abs(d_close - d_sma200) / d_sma200 < 0.015
d_at_floor = d_near_sma100 or d_near_sma200

// ==========================================
// 3. DETECCION DE VELAS Y SESIÓN (Gráfico 1H)
// ==========================================
is_first_bar = ta.change(time("D")) != 0
is_second_bar = ta.change(time("D"))[1] != 0 and not is_first_bar

body = math.abs(close - open)
range_c = high - low
is_green = close > open
is_red = close < open

is_solid_green = is_green and body > 0.6 * range_c
is_solid_red   = is_red and body > 0.6 * range_c

is_hammer = is_green and (open - low) > 2 * body and (high - close) < 0.2 * body
is_hanger = is_red and (close - low) > 2 * body and (high - open) < 0.2 * body

// Mejoras de Colas de Rechazo (Piso y Techo)
lower_wick = is_green ? (open - low) : (close - low)
upper_wick = is_green ? (high - close) : (high - open)

// Una cola de piso/techo debe ser al menos el 50% del rango total de la vela y el cuerpo máximo el 40%
is_cola_piso = range_c > 0 and lower_wick >= 0.5 * range_c and body <= 0.4 * range_c
is_cola_techo = range_c > 0 and upper_wick >= 0.5 * range_c and body <= 0.4 * range_c

// ==========================================
// 4. LÓGICA DE LAS ESTRATEGIAS (CALL & PUT)
// ==========================================
var string GP_STRAT = "Activar Estrategias"
enable_gap_normal = input.bool(true, "Gap Normal al Alza (CALL)", group=GP_STRAT)
enable_gap_bajista = input.bool(true, "Gap Bajista al Alza (CALL)", group=GP_STRAT)
enable_piso_fuerte = input.bool(true, "Piso Fuerte (CALL)", group=GP_STRAT)
enable_primer_gap = input.bool(true, "Primer Gap al Alza (CALL)", group=GP_STRAT)
enable_cola_piso = input.bool(true, "Cola de Piso en Soporte (CALL)", group=GP_STRAT)
enable_pm40_bounce = input.bool(true, "Promedio Móvil de 40 (CALL)", group=GP_STRAT)
enable_caida_break = input.bool(true, "Caída Normal/Fuerte (CALL)", group=GP_STRAT)
enable_canal_break = input.bool(true, "Ruptura Canal Bajista (CALL)", group=GP_STRAT)
enable_ruptura_res  = input.bool(true, "Ruptura de Resistencia (CALL)", group=GP_STRAT)

enable_velas_rojas = input.bool(true, "Primera Vela Roja (PUT)", group=GP_STRAT)
enable_techo_fuerte = input.bool(true, "Techo Fuerte (PUT)", group=GP_STRAT)
enable_ruptura_piso = input.bool(true, "Ruptura del Piso del Gap (PUT)", group=GP_STRAT)
enable_4_pasos     = input.bool(true, "Modelo de los 4 Pasos (PUT)", group=GP_STRAT)
enable_cola_techo = input.bool(true, "Cola de Techo en Resistencia (PUT)", group=GP_STRAT)
enable_hanger_diario = input.bool(true, "Hanger en Diario (PUT)", group=GP_STRAT)
enable_ruptura_sop  = input.bool(true, "Ruptura de Soporte (PUT)", group=GP_STRAT)
enable_piso_break   = input.bool(true, "Ruptura de Piso Fuerte (PUT)", group=GP_STRAT)
enable_gap_cont_put = input.bool(true, "Gap Bajista de Continuación (PUT)", group=GP_STRAT)

// Variables de estado para persistir datos durante el día
var float day_open_gap = 0.0
var float day_first_bar_low = 0.0
var float day_first_bar_high = 0.0
var bool day_floor_respected = true
var bool day_first_bar_green = false
var bool day_first_bar_red = false

if is_first_bar
    day_open_gap := (open - close[1]) / close[1] * 100
    day_first_bar_low := low
    day_first_bar_high := high
    day_floor_respected := true
    day_first_bar_green := is_solid_green or is_hammer
    day_first_bar_red := is_solid_red or is_hanger
else
    if low < day_first_bar_low
        day_floor_respected := false

// --- ESTRATEGIAS CALL ---

// 1. Gap Normal al Alza (CALL)
cond_gap_normal = enable_gap_normal and d_trend_bullish and is_second_bar and day_open_gap > 0.1 and day_first_bar_green and is_green

// 2. Gap Bajista al Alza (CALL)
cond_gap_bajista = enable_gap_bajista and is_second_bar and day_open_gap < -0.1 and day_first_bar_green and is_green

// 3. Piso Fuerte (CALL)
cond_piso_fuerte = enable_piso_fuerte and d_trend_bullish and d_at_floor and ta.crossover(close, pm20) and (is_solid_green or is_hammer)

// 4. Primer Gap al Alza (CALL)
is_last_bar_of_day = (hour == 15 and timeframe.isminutes and timeframe.multiplier == 60) or (hour == 15 and timeframe.multiplier == 60)
cond_primer_gap = enable_primer_gap and d_at_floor and is_last_bar_of_day and day_open_gap > 0.1 and day_first_bar_green and day_floor_respected and close < pm40[5]

// 5. Cola de Piso en Soporte (CALL)
lowest_20 = ta.lowest(low, 20)[1]
near_low = low <= lowest_20 + range_c * 0.5
near_ma_piso = (low <= pm10 * 1.0015 and close >= pm10) or (low <= pm20 * 1.0015 and close >= pm20) or (low <= pm40 * 1.0015 and close >= pm40) or (low <= pm100 * 1.0015 and close >= pm100) or (low <= pm200 * 1.0015 and close >= pm200)
cond_cola_piso = enable_cola_piso and is_cola_piso and (near_low or near_ma_piso)

// 11. Promedio Móvil de 40 (CALL)
touched_pm40 = ta.barssince(low <= pm40 * 1.0015 and close >= pm40 * 0.9985) <= 3
cond_pm40_bounce = enable_pm40_bounce and pm20 > pm40 and touched_pm40 and ta.crossover(close, ta.highest(high, 3)[1]) and is_solid_green

// 12. Caída Normal y Caída Fuerte (CALL)
recent_peak = ta.highest(high, 10)[1]
pct_drop = (recent_peak - low) / recent_peak * 100
is_caida_valida = pct_drop >= 0.5
cond_caida_break = enable_caida_break and d_trend_bullish and is_caida_valida and ta.crossover(close, ta.highest(high, 3)[1]) and is_solid_green

// 13. Ruptura del Canal Bajista (CALL)
in_descending_channel = pm20 < pm40
cond_canal_break = enable_canal_break and in_descending_channel and ta.crossover(close, ta.highest(high, 15)[1]) and is_solid_green

// 15. Ruptura de Resistencia (CALL)
cond_ruptura_res = enable_ruptura_res and d_trend_bullish and ta.crossover(close, ta.highest(high, 20)[1]) and is_solid_green

// --- ESTRATEGIAS PUT ---

// 6. Primera Vela Roja (PUT)
cond_vela_roja = enable_velas_rojas and is_first_bar and is_solid_red and close > pm40

// 7. Techo Fuerte (PUT)
cond_techo_fuerte = enable_techo_fuerte and d_at_floor and is_second_bar and is_red[1] and is_solid_red

// 8. Ruptura del Piso del Gap (PUT)
cond_ruptura_piso = enable_ruptura_piso and not is_first_bar and close > pm40 and close[1] >= day_first_bar_low and close < day_first_bar_low and is_solid_red

// 9. Modelo de los 4 Pasos (PUT)
cond_4_pasos = enable_4_pasos and close < pm40 and is_red and is_green[1] and close < open[1] and ta.crossunder(close, ta.lowest(low, 3)[1])

// 10. Cola de Techo en Resistencia (PUT)
highest_20 = ta.highest(high, 20)[1]
near_high = high >= highest_20 - range_c * 0.5
near_ma_techo = (high >= pm10 * 0.9985 and close <= pm10) or (high >= pm20 * 0.9985 and close <= pm20) or (high >= pm40 * 0.9985 and close <= pm40) or (high >= pm100 * 0.9985 and close <= pm100) or (high >= pm200 * 0.9985 and close <= pm200)
cond_cola_techo = enable_cola_techo and is_cola_techo and (near_high or near_ma_techo)

// 14. Hanger en Diario (PUT)
d_body = math.abs(d_close - d_open)
d_range = d_high - d_low
d_upper_wick = d_high - math.max(d_open, d_close)
d_is_hanger = d_range > 0 and d_upper_wick >= 0.5 * d_range and d_body <= 0.4 * d_range
cond_hanger_diario = enable_hanger_diario and is_last_bar_of_day and d_is_hanger and d_close > d_sma100

// 16. Ruptura de Soporte (PUT)
cond_ruptura_sop = enable_ruptura_sop and not d_trend_bullish and ta.crossunder(close, ta.lowest(low, 20)[1]) and is_solid_red

// 17. Ruptura de Piso Fuerte (PUT)
cond_piso_break = enable_piso_break and (ta.crossunder(close, d_sma100) or ta.crossunder(close, d_sma200)) and is_solid_red

// 18. Gap Bajista de Continuación (PUT)
cond_gap_cont_put = enable_gap_cont_put and is_second_bar and day_open_gap < -0.1 and day_first_bar_red and is_red

// ==========================================
// 5. EJECUCIÓN DE SEÑALES Y BACKTESTING
// ==========================================
var string GP_BACKTEST = "Rango de Backtesting"
bt_start_year  = input.int(2020, "Año de Inicio", group=GP_BACKTEST)
bt_start_month = input.int(1, "Mes de Inicio", group=GP_BACKTEST)
bt_start_day   = input.int(1, "Día de Inicio", group=GP_BACKTEST)
bt_end_year    = input.int(2028, "Año de Fin", group=GP_BACKTEST)
bt_end_month   = input.int(12, "Mes de Fin", group=GP_BACKTEST)
bt_end_day     = input.int(31, "Día de Fin", group=GP_BACKTEST)

in_date_range = true

// Señales de Entrada
signal_call = (cond_gap_normal or cond_gap_bajista or cond_piso_fuerte or cond_primer_gap or cond_cola_piso or cond_pm40_bounce or cond_caida_break or cond_canal_break or cond_ruptura_res) and in_date_range
signal_put  = (cond_vela_roja or cond_techo_fuerte or cond_ruptura_piso or cond_4_pasos or cond_cola_techo or cond_hanger_diario or cond_ruptura_sop or cond_piso_break or cond_gap_cont_put) and in_date_range

// Determinar el nombre de la estrategia y su probabilidad para alertas y etiquetas
string active_call_strategy = ""
string call_win_rate = ""
string active_put_strategy = ""
string put_win_rate = ""

if cond_gap_normal
    active_call_strategy := "Gap Normal al Alza"
    call_win_rate := "51.02%"
else if cond_gap_bajista
    active_call_strategy := "Gap Bajista al Alza"
    call_win_rate := "41.45%"
else if cond_piso_fuerte
    active_call_strategy := "Piso Fuerte"
    call_win_rate := "28.00%"
else if cond_primer_gap
    active_call_strategy := "Primer Gap al Alza"
    call_win_rate := "37.50%"
else if cond_cola_piso
    active_call_strategy := "Cola de Piso"
    call_win_rate := "47.81%"
else if cond_pm40_bounce
    active_call_strategy := "Promedio Móvil de 40"
    call_win_rate := "47.88%"
else if cond_caida_break
    active_call_strategy := "Caída Normal/Fuerte"
    call_win_rate := "44.83%"
else if cond_canal_break
    active_call_strategy := "Ruptura Canal Bajista"
    call_win_rate := "46.30%"
else if cond_ruptura_res
    active_call_strategy := "Ruptura de Resistencia"
    call_win_rate := "48.15%"

if cond_vela_roja
    active_put_strategy := "Primera Vela Roja"
    put_win_rate := "50.00%"
else if cond_techo_fuerte
    active_put_strategy := "Techo Fuerte"
    put_win_rate := "40.15%"
else if cond_ruptura_piso
    active_put_strategy := "Ruptura Piso del Gap"
    put_win_rate := "37.78%"
else if cond_4_pasos
    active_put_strategy := "Modelo de 4 Pasos"
    put_win_rate := "40.94%"
else if cond_cola_techo
    active_put_strategy := "Cola de Techo"
    put_win_rate := "39.47%"
else if cond_hanger_diario
    active_put_strategy := "Hanger en Diario"
    put_win_rate := "42.86%"
else if cond_ruptura_sop
    active_put_strategy := "Ruptura de Soporte"
    put_win_rate := "37.86%"
else if cond_piso_break
    active_put_strategy := "Ruptura de Piso Fuerte"
    put_win_rate := "37.84%"
else if cond_gap_cont_put
    active_put_strategy := "Gap Bajista de Continuación"
    put_win_rate := "36.61%"

// Gestión de Posiciones
is_in_call = strategy.position_size > 0
is_in_put  = strategy.position_size < 0

// Lógica de Salida
cond_exit_call = is_in_call and is_first_bar and is_red
cond_exit_put = is_in_put and is_first_bar and is_green

// Ejecución de trades en el Backtesting con payloads JSON para Webhooks y Etiquetas Dinámicas
if signal_call and not is_in_call
    strategy.entry("CALL", strategy.long, alert_message = '{"action": "buy", "ticker": "' + syminfo.ticker + '", "type": "CALL", "strategy": "' + active_call_strategy + '", "price": "' + str.tostring(close) + '", "quantity": 1}')
    alert("¡SEÑAL CALL! Activo: " + syminfo.ticker + " | Estrategia: " + active_call_strategy, alert.freq_once_per_bar)
    label.new(x=bar_index, y=low, text="CALL · " + active_call_strategy + " · " + call_win_rate, color=color.new(color.green, 15), textcolor=color.white, size=size.small, style=label.style_label_up, yloc=yloc.belowbar)

if signal_put and not is_in_put
    strategy.entry("PUT", strategy.short, alert_message = '{"action": "buy", "ticker": "' + syminfo.ticker + '", "type": "PUT", "strategy": "' + active_put_strategy + '", "price": "' + str.tostring(close) + '", "quantity": 1}')
    alert("¡SEÑAL PUT! Activo: " + syminfo.ticker + " | Estrategia: " + active_put_strategy, alert.freq_once_per_bar)
    label.new(x=bar_index, y=high, text="PUT · " + active_put_strategy + " · " + put_win_rate, color=color.new(color.red, 15), textcolor=color.white, size=size.small, style=label.style_label_down, yloc=yloc.abovebar)

if cond_exit_call and is_in_call[1]
    strategy.close("CALL", alert_message = '{"action": "sell", "ticker": "' + syminfo.ticker + '", "type": "CALL", "price": "' + str.tostring(close) + '"}')
    alert("¡SALIDA CALL! Activo: " + syminfo.ticker + " | Salida por primera vela roja de apertura", alert.freq_once_per_bar)
    label.new(x=bar_index, y=high, text="Salida CALL", color=color.new(color.orange, 30), textcolor=color.black, size=size.tiny, style=label.style_label_down, yloc=yloc.abovebar)

if cond_exit_put and is_in_put[1]
    strategy.close("PUT", alert_message = '{"action": "sell", "ticker": "' + syminfo.ticker + '", "type": "PUT", "price": "' + str.tostring(close) + '"}')
    alert("¡SALIDA PUT! Activo: " + syminfo.ticker + " | Salida por primera vela verde de apertura", alert.freq_once_per_bar)
    label.new(x=bar_index, y=low, text="Salida PUT", color=color.new(color.orange, 30), textcolor=color.black, size=size.tiny, style=label.style_label_up, yloc=yloc.belowbar)

// ==========================================
// 5b. ZONAS BARATA / CARA (dibujo automático)
// ==========================================
var string GP_ZONA = "Zonas Barata / Cara"
show_zonas   = input.bool(true, "Dibujar zonas Barata / Cara", group=GP_ZONA)
zona_lookback = input.int(100, "Velas para medir piso/techo", minval=20, group=GP_ZONA)
zona_pct     = input.float(15.0, "Ancho de zona (% del rango)", minval=1.0, maxval=50.0, group=GP_ZONA) / 100
zona_ma_tol  = input.float(0.2, "Tolerancia a promedio móvil (%)", minval=0.0, step=0.05, group=GP_ZONA) / 100
zona_gap     = input.int(20, "Velas para unir zonas cercanas", minval=1, group=GP_ZONA)

rng_hi  = ta.highest(high, zona_lookback)
rng_lo  = ta.lowest(low, zona_lookback)
rng     = rng_hi - rng_lo
rng_pos = rng > 0 ? (close - rng_lo) / rng : 0.5

// Toque de promedios móviles: soporte (por arriba) y resistencia (por abajo)
ma_soporte = (low <= pm40 * (1 + zona_ma_tol) and close >= pm40) or (low <= pm100 * (1 + zona_ma_tol) and close >= pm100) or (low <= pm200 * (1 + zona_ma_tol) and close >= pm200)
ma_resist  = (high >= pm40 * (1 - zona_ma_tol) and close <= pm40) or (high >= pm100 * (1 - zona_ma_tol) and close <= pm100) or (high >= pm200 * (1 - zona_ma_tol) and close <= pm200)

// Barata: cerca del piso del rango, o tocando un promedio como soporte en la mitad baja
// Cara: cerca del techo del rango, o tocando un promedio como resistencia en la mitad alta
zona_barata = rng > 0 and (rng_pos <= zona_pct or (ma_soporte and rng_pos <= 0.65))
zona_cara   = rng > 0 and (rng_pos >= 1 - zona_pct or (ma_resist and rng_pos >= 0.35))

var box box_barata = na
var box box_cara   = na

var int last_barata = -100000
var int last_cara   = -100000
if show_zonas
    if zona_barata
        if bar_index - last_barata > zona_gap
            if not na(box_barata)
                box.set_text(box_barata, "")
                box.set_bgcolor(box_barata, color.new(color.green, 94))
            box_barata := box.new(bar_index, math.max(high, rng_lo + rng * zona_pct), bar_index, math.min(low, rng_lo), border_color=color.green, bgcolor=color.new(color.green, 85), text="Zona Barata - Comprar Call", text_color=color.green, text_size=size.small, text_halign=text.align_left, text_valign=text.align_top)
            alert("ZONA BARATA - Comprar Call | Activo: " + syminfo.ticker + " | Precio: " + str.tostring(close), alert.freq_once_per_bar)
        else
            box.set_right(box_barata, bar_index)
            box.set_top(box_barata, rng_lo + rng * zona_pct)
            box.set_bottom(box_barata, rng_lo)
        last_barata := bar_index
    if zona_cara
        if bar_index - last_cara > zona_gap
            if not na(box_cara)
                box.set_text(box_cara, "")
                box.set_bgcolor(box_cara, color.new(color.red, 94))
            box_cara := box.new(bar_index, math.max(high, rng_hi), bar_index, math.min(low, rng_hi - rng * zona_pct), border_color=color.red, bgcolor=color.new(color.red, 85), text="Zona Cara - Comprar Put", text_color=color.red, text_size=size.small, text_halign=text.align_left, text_valign=text.align_top)
            alert("ZONA CARA - Comprar Put | Activo: " + syminfo.ticker + " | Precio: " + str.tostring(close), alert.freq_once_per_bar)
        else
            box.set_right(box_cara, bar_index)
            box.set_bottom(box_cara, rng_hi - rng * zona_pct)
            box.set_top(box_cara, rng_hi)
        last_cara := bar_index

// ==========================================
// 6. DIBUJO DE SEÑALES EN EL GRÁFICO (Círculos solicitados por el usuario)
// ==========================================
// Ploteo de entradas principales (Triángulos sin texto para evitar superposición con las etiquetas)
plotshape(signal_call and not is_in_call[1] and not cond_cola_piso, title="Señal CALL (Gaps/Piso)", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.normal)
plotshape(signal_put and not is_in_put[1] and not cond_cola_techo, title="Señal PUT (Vela/Techo)", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.normal)

// Ploteo de Cola de Piso y Cola de Techo como círculos (resaltados a pedido del usuario)
plotshape(cond_cola_piso and not is_in_call[1], title="Cola de Piso (CALL)", style=shape.circle, location=location.belowbar, color=color.green, size=size.normal)
plotshape(cond_cola_techo and not is_in_put[1], title="Cola de Techo (PUT)", style=shape.circle, location=location.abovebar, color=color.red, size=size.normal)

// Ploteo de salidas
plotshape(cond_exit_call and is_in_call[1], title="Salida CALL", style=shape.xcross, location=location.abovebar, color=color.orange, size=size.small)
plotshape(cond_exit_put and is_in_put[1], title="Salida PUT", style=shape.xcross, location=location.belowbar, color=color.orange, size=size.small)

// ==========================================
// 7. CANAL PARALELO AUTOMATICO (por pivotes)
// ==========================================
var string GP_CAN = "Canal automatico"
show_canal = input.bool(true, "Dibujar canal automatico", group=GP_CAN)
can_len    = input.int(10, "Fuerza del pivote (velas a cada lado)", minval=3, group=GP_CAN)
ph = ta.pivothigh(high, can_len, can_len)
pl = ta.pivotlow(low, can_len, can_len)
var int hx1 = na
var float hy1 = na
var int hx2 = na
var float hy2 = na
var int lx1 = na
var float ly1 = na
var int lx2 = na
var float ly2 = na
if not na(ph)
    hx1 := hx2
    hy1 := hy2
    hx2 := bar_index - can_len
    hy2 := ph
if not na(pl)
    lx1 := lx2
    ly1 := ly2
    lx2 := bar_index - can_len
    ly2 := pl
var line can_main = na
var line can_par = na
if show_canal and barstate.islast and not na(hx1) and not na(lx1)
    line.delete(can_main)
    line.delete(can_par)
    bajista = hy2 < hy1
    alcista = ly2 > ly1
    if bajista and (not alcista or hx2 >= lx2)
        sl = (hy2 - hy1) / (hx2 - hx1)
        can_main := line.new(hx1, hy1, hx2, hy2, extend=extend.right, color=color.red, width=2)
        can_par := line.new(lx2, ly2, lx2 + 1, ly2 + sl, extend=extend.right, color=color.red, width=2, style=line.style_dashed)
    else if alcista
        sl = (ly2 - ly1) / (lx2 - lx1)
        can_main := line.new(lx1, ly1, lx2, ly2, extend=extend.right, color=color.green, width=2)
        can_par := line.new(hx2, hy2, hx2 + 1, hy2 + sl, extend=extend.right, color=color.green, width=2, style=line.style_dashed)

// ==========================================
// 8. PANEL COMPARATIVO CARDONA (condiciones cumplidas por estrategia)
// ==========================================
var string GP_TAB = "Panel Cardona"
show_panel = input.bool(true, "Mostrar panel comparativo", group=GP_TAB)
b2i(b) => b ? 1 : 0
x_cr20  = ta.crossover(close, pm20)
x_up3   = ta.crossover(close, ta.highest(high, 3)[1])
x_up15  = ta.crossover(close, ta.highest(high, 15)[1])
x_up20  = ta.crossover(close, ta.highest(high, 20)[1])
x_dn3   = ta.crossunder(close, ta.lowest(low, 3)[1])
x_dn20  = ta.crossunder(close, ta.lowest(low, 20)[1])
x_dn100 = ta.crossunder(close, d_sma100)
x_dn200 = ta.crossunder(close, d_sma200)
n1  = b2i(d_trend_bullish) + b2i(is_second_bar) + b2i(day_open_gap > 0.1) + b2i(day_first_bar_green) + b2i(is_green)
n2  = b2i(is_second_bar) + b2i(day_open_gap < -0.1) + b2i(day_first_bar_green) + b2i(is_green)
n3  = b2i(d_trend_bullish) + b2i(d_at_floor) + b2i(x_cr20) + b2i(is_solid_green or is_hammer)
n4  = b2i(d_at_floor) + b2i(is_last_bar_of_day) + b2i(day_open_gap > 0.1) + b2i(day_first_bar_green) + b2i(day_floor_respected) + b2i(close < pm40[5])
n5  = b2i(is_cola_piso) + b2i(near_low or near_ma_piso)
n6  = b2i(pm20 > pm40) + b2i(touched_pm40) + b2i(x_up3) + b2i(is_solid_green)
n7  = b2i(d_trend_bullish) + b2i(is_caida_valida) + b2i(x_up3) + b2i(is_solid_green)
n8  = b2i(pm20 < pm40) + b2i(x_up15) + b2i(is_solid_green)
n9  = b2i(d_trend_bullish) + b2i(x_up20) + b2i(is_solid_green)
n10 = b2i(is_first_bar) + b2i(is_solid_red) + b2i(close > pm40)
n11 = b2i(d_at_floor) + b2i(is_second_bar) + b2i(is_red[1]) + b2i(is_solid_red)
n12 = b2i(not is_first_bar) + b2i(close > pm40) + b2i(close[1] >= day_first_bar_low) + b2i(close < day_first_bar_low) + b2i(is_solid_red)
n13 = b2i(close < pm40) + b2i(is_red) + b2i(is_green[1]) + b2i(close < open[1]) + b2i(x_dn3)
n14 = b2i(is_cola_techo) + b2i(near_high or near_ma_techo)
n15 = b2i(is_last_bar_of_day) + b2i(d_is_hanger) + b2i(d_close > d_sma100)
n16 = b2i(not d_trend_bullish) + b2i(x_dn20) + b2i(is_solid_red)
n17 = b2i(x_dn100 or x_dn200) + b2i(is_solid_red)
n18 = b2i(is_second_bar) + b2i(day_open_gap < -0.1) + b2i(day_first_bar_red) + b2i(is_red)
var table tb = table.new(position.bottom_right, 3, 19, bgcolor=color.new(color.black, 25), border_width=1)
f_row(r, nm, n, t, call) =>
    c = n == t ? color.lime : n * 2 >= t ? color.orange : color.gray
    table.cell(tb, 0, r, nm, text_color=call ? color.lime : color.red, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, r, str.tostring(n) + "/" + str.tostring(t), text_color=c, text_size=size.small)
    table.cell(tb, 2, r, n == t ? "OK" : "-", text_color=c, text_size=size.small)
if show_panel and barstate.islast
    table.cell(tb, 0, 0, "Estrategias Cardona", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 0, "Cumple", text_color=color.white, text_size=size.small)
    table.cell(tb, 2, 0, "", text_size=size.small)
    f_row(1, "CALL Gap Normal", n1, 5, true)
    f_row(2, "CALL Gap Bajista", n2, 4, true)
    f_row(3, "CALL Piso Fuerte", n3, 4, true)
    f_row(4, "CALL Primer Gap", n4, 6, true)
    f_row(5, "CALL Cola de Piso", n5, 2, true)
    f_row(6, "CALL Prom. Movil 40", n6, 4, true)
    f_row(7, "CALL Caida Normal/Fuerte", n7, 4, true)
    f_row(8, "CALL Ruptura Canal Baj.", n8, 3, true)
    f_row(9, "CALL Ruptura Resistencia", n9, 3, true)
    f_row(10, "PUT Primera Vela Roja", n10, 3, false)
    f_row(11, "PUT Techo Fuerte", n11, 4, false)
    f_row(12, "PUT Ruptura Piso Gap", n12, 5, false)
    f_row(13, "PUT 4 Pasos", n13, 5, false)
    f_row(14, "PUT Cola de Techo", n14, 2, false)
    f_row(15, "PUT Hanger Diario", n15, 3, false)
    f_row(16, "PUT Ruptura Soporte", n16, 3, false)
    f_row(17, "PUT Ruptura Piso Fuerte", n17, 2, false)
    f_row(18, "PUT Gap Baj. Continuacion", n18, 4, false)

// ==========================================
// 9. CONFIRMACION PARA EL BOT (puntaje TradingView -> live_scanner via webhook)
// ==========================================
var string GP_TV = "Confirmacion TradingView"
tv_secret = input.string("", "Secreto del webhook (tv_webhook_secret.txt)", group=GP_TV)
rsi14 = ta.rsi(close, 14)
[macd_l, macd_s, macd_h] = ta.macd(close, 12, 26, 9)
vol_ok = volume > ta.sma(volume, 20)
tv_call = b2i(d_trend_bullish) + b2i(close > pm40) + b2i(pm20 > pm40) + b2i(rsi14 > 50) + b2i(macd_l > macd_s) + b2i(vol_ok)
tv_put  = b2i(not d_trend_bullish) + b2i(close < pm40) + b2i(pm20 < pm40) + b2i(rsi14 < 50) + b2i(macd_l < macd_s) + b2i(vol_ok)
if barstate.isconfirmed and signal_call and tv_secret != ""
    alert('{"tv_conf":true,"secret":"' + tv_secret + '","ticker":"' + syminfo.ticker + '","side":"CALL","strategy":"' + active_call_strategy + '","score":' + str.tostring(tv_call) + ',"max":6}', alert.freq_once_per_bar_close)
if barstate.isconfirmed and signal_put and tv_secret != ""
    alert('{"tv_conf":true,"secret":"' + tv_secret + '","ticker":"' + syminfo.ticker + '","side":"PUT","strategy":"' + active_put_strategy + '","score":' + str.tostring(tv_put) + ',"max":6}', alert.freq_once_per_bar_close)
